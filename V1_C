#include <bits/stdc++.h>
using namespace std;
int n;
vector<long long> a;
void siftDown(int i){
    while(2*i<=n){
        int c=2*i;
        if(c!=0 && c>a[c]){c=2*i+1;}
        if(a[c]>a[i]){swap(a[i],a[c]); i=c;}
        else{break;}
}
}
int main(){
    cin>>n;
    a.assign(n+1, 0);
    for(int i=1; i<=n; i++){
        cin>>a[i];
    }
    for(int i=n/2; i>=1; i--){
        siftDown(i);
    }
    for(int i=1; i<=n; i++){
        cout<<a[i]<<(i==n ? '\n' : ' ');
    }
    return 0;
}
