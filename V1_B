#include <bits/stdc++.h>
using namespace std;
int main(){
    int t;
    cin>>t;
    while(t--){
        long long m;
        cin>>m;
        long long low=0, high=2e9;
        while(low<=high){
            long long mid=low+(high-low)/2;
            if(mid*mid<=m){low=mid+1;}
            else{high=mid-1;}
        }
        cout<<high<<endl;
    }
    return 0;
}
