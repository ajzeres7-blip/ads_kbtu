#include <bits/stdc++.h>
using namespace std;
struct Node{
    long long val;
    Node* next;
    Node(long long v) : val(v), next(nullptr) {}
};

int main(){
    int n;
    cin>>n;
    Node* head=nullptr;
    Node* tail=nullptr;
    for(int i=0; i<n; i++){
        long long a; cin>>a;
        Node* newnode= new Node(a);
        if(head==nullptr){head=newnode; tail=head;}
        else{tail->next=newnode; tail=newnode;}
    }
    long long x;
    cin>>x;
    while(head!=nullptr && head->val==x){
        head=head->next;
    }
    Node* temp=head;
    while(temp!=nullptr&& temp->next!=nullptr){
        if(temp->next->val==x){
            temp->next=temp->next->next;
        }else{temp=temp->next;}
    }
    temp=head;
    while(temp!=nullptr){
        cout<<temp->val;
        if(temp->next!=nullptr){cout<<" ";}
        temp=temp->next;
    }
    cout<<endl;
    return 0;
}
