#include <bits/stdc++.h>
using namespace std;
int main(){
    int n;
    cin>>n;
    vector<int> a(n);
    for(auto& v : a) cin>>v;
    int q;
    cin>>q;
    while(q--){
        int x;
        cin>>x;
        int lo=0, hi=n-1;
        bool found=false;
        while(lo<=hi){
            int mid=lo+(hi-lo)/2;
            if(a[mid]==x){found=true; break;}
            else if(a[mid]<x){lo=mid+1;}
            else{hi=mid-1;}
        }
        cout<<(found ? "YES":"NO")<<endl;
    }
    return 0;
}
